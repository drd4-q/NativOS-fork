#!/bin/sh
# ═══════════════════════════════════════════════════════════════════
#  NativOS Initialization System & Process Supervisor (nativOS-init)
#
#  Modular, container/chroot-friendly init system and service manager
#  for Alpine Linux (postmarketOS) and Debian 13 (Trixie).
#
#  Usage:
#      nativOS-init start [OPTIONS]
#      nativOS-init stop
#      nativOS-init restart [SERVICE]
#      nativOS-init status
# ═══════════════════════════════════════════════════════════════════

set -e

# Default settings
SCREEN_WIDTH="${SCREEN_WIDTH:-1080}"
SCREEN_HEIGHT="${SCREEN_HEIGHT:-2160}"
DISPLAY_SCALE="${DISPLAY_SCALE:-2}"
GPU_MODE="${GPU_MODE:-software}"
APP_UID="${APP_UID:-1000}"
HOST_TMPDIR="${HOST_TMPDIR:-/tmp}"
RUN_DIR="/run/nativOS"
LOG_DIR="/var/log/nativOS"

# Colors for terminal logs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo "${BLUE}[nativOS-init]${NC} $1"
}

log_ok() {
    echo "${GREEN}[nativOS-init:OK]${NC} $1"
}

log_warn() {
    echo "${YELLOW}[nativOS-init:WARN]${NC} $1"
}

log_err() {
    echo "${RED}[nativOS-init:ERROR]${NC} $1"
}

WLR_RENDERER_PREF="${WLR_RENDERER_PREF:-auto}"
MESA_GLTHREAD_PREF="${MESA_GLTHREAD_PREF:-true}"

parse_start_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --width)
                SCREEN_WIDTH="$2"
                shift 2
                ;;
            --height)
                SCREEN_HEIGHT="$2"
                shift 2
                ;;
            --scale)
                DISPLAY_SCALE="$2"
                shift 2
                ;;
            --gpu)
                GPU_MODE="$2"
                shift 2
                ;;
            --app-uid)
                APP_UID="$2"
                shift 2
                ;;
            --desktop)
                DESKTOP_ENV="$2"
                shift 2
                ;;
            --tmpdir)
                HOST_TMPDIR="$2"
                shift 2
                ;;
            --transform)
                DISPLAY_TRANSFORM="$2"
                shift 2
                ;;
            --wlr-renderer)
                WLR_RENDERER_PREF="$2"
                shift 2
                ;;
            --mesa-glthread)
                MESA_GLTHREAD_PREF="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
}

# ───────────────────────────────────────────────────────────────────
#  Stage 1: System and Runtime Preparation
# ───────────────────────────────────────────────────────────────────
stage_sysinit() {
    log_info "Running Stage 1: Sysinit & runtime directories..."

    # Ensure critical runtime directories exist with proper permissions
    mkdir -p /tmp/runtime-root
    chown root:root /tmp/runtime-root 2>/dev/null || true
    chmod 0700 /tmp/runtime-root

    mkdir -p "$RUN_DIR" "$LOG_DIR" /run/dbus /run/sshd /tmp/.X11-unix /etc/nativOS
    chmod 0755 "$RUN_DIR" "$LOG_DIR" /run/dbus

    # Standard FHS /dev symlinks (often missing in Android root environments)
    [ -e /dev/fd ] || ln -snf /proc/self/fd /dev/fd 2>/dev/null || true
    [ -e /dev/stdin ] || ln -snf /proc/self/fd/0 /dev/stdin 2>/dev/null || true
    [ -e /dev/stdout ] || ln -snf /proc/self/fd/1 /dev/stdout 2>/dev/null || true
    [ -e /dev/stderr ] || ln -snf /proc/self/fd/2 /dev/stderr 2>/dev/null || true

    # Clean up stale locks and sockets
    rm -f /run/dbus/pid /run/dbus/system_bus_socket
    rm -f /tmp/runtime-root/wayland-* /tmp/runtime-root/wayland-*.lock 2>/dev/null || true
    rm -f "$RUN_DIR"/*.pid 2>/dev/null || true

    # Machine ID generation if not present
    if [ ! -s /etc/machine-id ]; then
        if command -v dbus-uuidgen >/dev/null 2>&1; then
            dbus-uuidgen --ensure=/etc/machine-id
        else
            cat /proc/sys/kernel/random/boot_id | tr -d '-' > /etc/machine-id 2>/dev/null || true
        fi
    fi

    # Set root lockscreen unlock PIN
    if command -v chpasswd >/dev/null 2>&1; then
        echo 'root:1234' | chpasswd 2>/dev/null || true
    fi

    log_ok "Stage 1 complete"
}

# ───────────────────────────────────────────────────────────────────
#  Stage 2: Core System Services
# ───────────────────────────────────────────────────────────────────
stage_services() {
    log_info "Running Stage 2: Core system services..."

    # 1. System D-Bus Daemon
    if ! pgrep -x dbus-daemon >/dev/null 2>&1; then
        if command -v dbus-daemon >/dev/null 2>&1; then
            log_info "Starting System D-Bus daemon..."
            mkdir -p /run/dbus
            rm -f /run/dbus/system_bus_socket /run/dbus/pid
            dbus-daemon --system --fork --nopidfile
            log_ok "System D-Bus started"
        else
            log_warn "dbus-daemon not found in PATH"
        fi
    else
        log_info "System D-Bus already running"
    fi

    # 2. Polkit Daemon
    POLKIT_BIN=""
    for candidate in /usr/lib/polkit-1/polkitd /usr/libexec/polkitd /usr/lib/polkit/polkitd; do
        if [ -x "$candidate" ]; then
            POLKIT_BIN="$candidate"
            break
        fi
    done

    if [ -n "$POLKIT_BIN" ] && ! pgrep -f polkitd >/dev/null 2>&1; then
        log_info "Starting Polkit ($POLKIT_BIN)..."
        "$POLKIT_BIN" --no-debug >"$LOG_DIR/polkitd.log" 2>&1 &
        echo $! > "$RUN_DIR/polkitd.pid"
        log_ok "Polkit started"
    fi

    # 3. NativOS Hardware Bridge Client
    BRIDGE_BIN=""
    for candidate in /usr/local/bin/nativOS-bridge /usr/bin/nativOS-bridge; do
        if [ -x "$candidate" ]; then
            BRIDGE_BIN="$candidate"
            break
        fi
    done

    if [ -n "$BRIDGE_BIN" ] && ! pgrep -f nativOS-bridge >/dev/null 2>&1; then
        log_info "Starting NativOS Hardware Bridge client..."
        "$BRIDGE_BIN" >"$LOG_DIR/bridge-client.log" 2>&1 &
        echo $! > "$RUN_DIR/bridge-client.pid"
        log_ok "Hardware Bridge client started"
    fi

    # 4. OpenSSH Server (if installed)
    if [ -x /usr/sbin/sshd ] && ! pgrep -x sshd >/dev/null 2>&1; then
        log_info "Configuring and starting SSH server on port 8022..."
        mkdir -p /run/sshd /root/.ssh /etc/ssh/sshd_config.d
        chmod 0700 /root/.ssh
        cat > /etc/ssh/sshd_config.d/nativOS.conf << 'SSHEOF'
Port 8022
ListenAddress 0.0.0.0
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
UsePAM no
SSHEOF
        [ -f /etc/ssh/ssh_host_rsa_key ] || ssh-keygen -A 2>/dev/null || true
        /usr/sbin/sshd -E "$LOG_DIR/sshd.log" 2>/dev/null && log_ok "SSH ready on port 8022 (key only)" || log_warn "SSH failed to start"
    fi

    # 5. OpenRC Integration (when running on Alpine/postmarketOS)
    if command -v rc-service >/dev/null 2>&1; then
        log_info "Alpine/postmarketOS detected: checking OpenRC services..."
        rc-service dbus status >/dev/null 2>&1 || rc-service dbus start 2>/dev/null || true
    fi

    log_ok "Stage 2 complete"
}

# ───────────────────────────────────────────────────────────────────
#  Stage 3: Desktop Environment & Compositor
# ───────────────────────────────────────────────────────────────────
stage_desktop() {
    log_info "Running Stage 3: Desktop Environment (Phosh/Phoc)..."

    # Export base FHS environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export TMPDIR=/tmp
    export HOME=/root
    export XDG_RUNTIME_DIR=/tmp/runtime-root
    export XDG_SESSION_TYPE=x11
    export XDG_CURRENT_DESKTOP=Phosh
    export XDG_SESSION_DESKTOP=phosh
    export DESKTOP_SESSION=phosh
    export XDG_DATA_HOME=/root/.local/share
    export XDG_DATA_DIRS=/root/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/run/nativOS/android-apps/share:/usr/local/share:/usr/share
    export XDG_CONFIG_DIRS=/etc/xdg
    export DISPLAY=:0
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export GTK_A11Y=none
    export GSK_RENDERER=cairo

    # Determine wlroots renderer (phoc compositor engine)
    if [ "$WLR_RENDERER_PREF" = "gles2" ] || [ "$WLR_RENDERER_PREF" = "pixman" ]; then
        export WLR_RENDERER="$WLR_RENDERER_PREF"
    elif [ "$GPU_MODE" = "turnip" ] || [ "$GPU_MODE" = "zink" ] || [ "$GPU_MODE" = "virgl" ]; then
        export WLR_RENDERER=gles2
    else
        export WLR_RENDERER=pixman
    fi
    log_info "Desktop compositor renderer: $WLR_RENDERER (pref: $WLR_RENDERER_PREF)"

    # GPU acceleration settings
    if [ "$GPU_MODE" = "turnip" ]; then
        log_info "Enabling Turnip/Zink hardware acceleration (Qualcomm Adreno)"
        export NATIVOS_GPU=turnip
        unset LIBGL_ALWAYS_SOFTWARE
        unset GBM_ALWAYS_SOFTWARE
        export GALLIUM_DRIVER=zink
        export MESA_LOADER_DRIVER_OVERRIDE=zink
        export TU_DEBUG=noconform
        export ZINK_DESCRIPTORS=lazy
        export MESA_VK_WSI_DEBUG=sw
        export MESA_VK_WSI_PRESENT_MODE=mailbox
        export MESA_SHADER_CACHE_DIR=/tmp/mesa_shader_cache
        export MESA_SHADER_CACHE_MAX_SIZE=512M
        mkdir -p /tmp/mesa_shader_cache 2>/dev/null || true
        TURNIP_ICD=$(find /opt/nativOS-gpu /usr/share/vulkan/icd.d -name "*freedreno*.json" 2>/dev/null | head -n 1)
        [ -n "$TURNIP_ICD" ] && export VK_ICD_FILENAMES="$TURNIP_ICD"
    elif [ "$GPU_MODE" = "virgl" ]; then
        log_info "Enabling VirGL hardware acceleration"
        export NATIVOS_GPU=virgl
        unset LIBGL_ALWAYS_SOFTWARE
        unset GBM_ALWAYS_SOFTWARE
        export GALLIUM_DRIVER=virpipe
        export MESA_GL_VERSION_OVERRIDE=4.3
        export MESA_SHADER_CACHE_DIR=/tmp/mesa_shader_cache
        mkdir -p /tmp/mesa_shader_cache 2>/dev/null || true
    elif [ "$GPU_MODE" = "zink" ]; then
        log_info "Enabling generic Zink Vulkan acceleration (Mali/Tensor)"
        export NATIVOS_GPU=zink
        unset LIBGL_ALWAYS_SOFTWARE
        unset GBM_ALWAYS_SOFTWARE
        export GALLIUM_DRIVER=zink
        export MESA_LOADER_DRIVER_OVERRIDE=zink
        export ZINK_DESCRIPTORS=lazy
        export MESA_VK_WSI_DEBUG=sw
        export MESA_VK_WSI_PRESENT_MODE=mailbox
        export MESA_SHADER_CACHE_DIR=/tmp/mesa_shader_cache
        export MESA_SHADER_CACHE_MAX_SIZE=512M
        mkdir -p /tmp/mesa_shader_cache 2>/dev/null || true
    else
        log_info "Using optimized Mesa multi-threaded software rendering (llvmpipe)"
        export NATIVOS_GPU=software
        export WLR_RENDERER=pixman
        export LIBGL_ALWAYS_SOFTWARE=1
        export GBM_ALWAYS_SOFTWARE=1
        export GALLIUM_DRIVER=llvmpipe
        export MESA_LOADER_DRIVER_OVERRIDE=swrast
        export LP_NUM_THREADS=$(nproc 2>/dev/null || echo 4)
    fi

    if [ "${MESA_GLTHREAD_PREF:-true}" = "true" ]; then
        export mesa_glthread=true
        export GALLIUM_THREAD=1
    fi

    # wlroots configuration for embedded X11 display
    export WLR_BACKENDS=x11
    export WLR_X11_OUTPUTS=1
    export WLR_DRM_NO_ATOMIC=1
    export WLR_DRM_DEVICES=""

    # Abstract socket path compatibility with Android X11 server
    export TMPDIR="$HOST_TMPDIR"

    # Build LD_PRELOAD list from available compatibility libraries
    PRELOAD=""
    for lib in \
        /usr/local/lib/libsocket_hook.so \
        /usr/local/lib/libnativos-close-range.so \
        /usr/local/lib/libnodri3.so \
        /usr/local/lib/libandroid-shmem.so; do
        if [ -f "$lib" ]; then
            if env -i LD_PRELOAD="$lib" /bin/sh -c 'exit 0' 2>/dev/null; then
                if [ -z "$PRELOAD" ]; then
                    PRELOAD="$lib"
                else
                    PRELOAD="$PRELOAD:$lib"
                fi
            else
                log_warn "Excluding broken/incompatible preload library: $lib"
            fi
        fi
    done

    # App preload excludes libnodri3 for GPU-accelerated applications
    APP_PRELOAD=""
    for lib in \
        /usr/local/lib/libsocket_hook.so \
        /usr/local/lib/libnativos-close-range.so \
        /usr/local/lib/libandroid-shmem.so; do
        if [ -f "$lib" ]; then
            if env -i LD_PRELOAD="$lib" /bin/sh -c 'exit 0' 2>/dev/null; then
                if [ -z "$APP_PRELOAD" ]; then
                    APP_PRELOAD="$lib"
                else
                    APP_PRELOAD="$APP_PRELOAD:$lib"
                fi
            fi
        fi
    done

    export LD_PRELOAD="$PRELOAD"
    export NATIVOS_APP_LD_PRELOAD="$APP_PRELOAD"

    # High-framerate and low-latency rendering optimizations
    export MESA_VK_WSI_PRESENT_MODE=mailbox
    export TU_DEBUG=noconform
    export vblank_mode=0
    export WLR_NO_HARDWARE_CURSORS=1
    export LP_NUM_THREADS=$(nproc 2>/dev/null || echo 4)

    # Generate Phoc compositor config
    cat > /etc/nativOS/phoc.ini << PHOCEOF
[core]
xwayland=false

[output:X11-1]
mode=${SCREEN_WIDTH}x${SCREEN_HEIGHT}
scale=$DISPLAY_SCALE
max_render_time=1
PHOCEOF

    log_ok "Display configured: ${SCREEN_WIDTH}x${SCREEN_HEIGHT} @ scale ${DISPLAY_SCALE}"

    DESKTOP_ENV="${DESKTOP_ENV:-phosh}"
    log_info "Desktop Environment selected: $DESKTOP_ENV"

    # Prepare launcher command based on requested environment
    case "$DESKTOP_ENV" in
        plasma-mobile)
            log_info "Preparing Plasma Mobile session..."
            if command -v kwin_wayland >/dev/null 2>&1; then
                LAUNCH_CMD="kwin_wayland --x11-display :0 --width $SCREEN_WIDTH --height $SCREEN_HEIGHT --exit-with-session=startplasma-mobile"
            elif command -v startplasma-mobile >/dev/null 2>&1; then
                LAUNCH_CMD="startplasma-mobile"
            else
                log_warn "Plasma Mobile not found; falling back to Phosh"
                DESKTOP_ENV="phosh"
            fi
            ;;
        sxmo)
            log_info "Preparing Sxmo (Sway) ultra-smooth mobile session..."
            if command -v sxmo_hook_start.sh >/dev/null 2>&1; then
                LAUNCH_CMD="sxmo_hook_start.sh"
            elif command -v sway >/dev/null 2>&1; then
                LAUNCH_CMD="sway -c /etc/sxmo/sway/config 2>/dev/null || sway"
            else
                log_warn "Sxmo not found; falling back to Phosh"
                DESKTOP_ENV="phosh"
            fi
            ;;
        xfce4)
            log_info "Preparing XFCE4 lightweight X11 desktop..."
            if command -v startxfce4 >/dev/null 2>&1; then
                LAUNCH_CMD="startxfce4"
            elif command -v xfce4-session >/dev/null 2>&1; then
                LAUNCH_CMD="xfce4-session"
            else
                log_warn "XFCE4 not found; falling back to Phosh"
                DESKTOP_ENV="phosh"
            fi
            ;;
        gnome)
            log_info "Preparing GNOME session..."
            LAUNCH_CMD="gnome-session"
            ;;
        plasma)
            log_info "Preparing KDE Plasma desktop..."
            if command -v startplasma-x11 >/dev/null 2>&1; then
                LAUNCH_CMD="startplasma-x11"
            elif command -v kwin_wayland >/dev/null 2>&1; then
                LAUNCH_CMD="kwin_wayland --x11-display :0 --width $SCREEN_WIDTH --height $SCREEN_HEIGHT --exit-with-session=startplasma-wayland"
            else
                log_warn "KDE Plasma not found; falling back to Phosh"
                DESKTOP_ENV="phosh"
            fi
            ;;
        lxqt)
            log_info "Preparing LXQt desktop..."
            LAUNCH_CMD="startlxqt"
            ;;
        mate)
            log_info "Preparing MATE desktop..."
            LAUNCH_CMD="mate-session"
            ;;
    esac

    # Default: Phosh
    if [ "$DESKTOP_ENV" = "phosh" ]; then
        PHOSH_EXEC="/usr/libexec/phosh"
        [ -x "$PHOSH_EXEC" ] || PHOSH_EXEC="/usr/bin/phosh"

        XDG_PORTAL_GTK=$(command -v xdg-desktop-portal-gtk 2>/dev/null || echo "/usr/libexec/xdg-desktop-portal-gtk")
        XDG_PORTAL=$(command -v xdg-desktop-portal 2>/dev/null || echo "/usr/libexec/xdg-desktop-portal")

        if ! command -v phoc >/dev/null 2>&1; then
            log_err "phoc compositor not found! Falling back to terminal..."
            if command -v kgx >/dev/null 2>&1; then
                exec kgx
            elif command -v gnome-terminal >/dev/null 2>&1; then
                exec gnome-terminal
            else
                log_err "No desktop or terminal found!"
                sleep 3600
                exit 1
            fi
        fi

        LAUNCH_CMD="phoc -C /etc/nativOS/phoc.ini -E \"sh -c '
            export LD_PRELOAD=\\\"\$NATIVOS_APP_LD_PRELOAD\\\"
            [ -x \\\"$XDG_PORTAL_GTK\\\" ] && \\\"$XDG_PORTAL_GTK\\\" >\\\"$LOG_DIR/portal-gtk.log\\\" 2>&1 &
            [ -x \\\"$XDG_PORTAL\\\" ] && \\\"$XDG_PORTAL\\\" >\\\"$LOG_DIR/portal.log\\\" 2>&1 &
            exec \\\"$PHOSH_EXEC\\\" -U
        '\""
    fi

    log_info "Launching desktop supervisor ($DESKTOP_ENV)..."
    echo $$ > "$RUN_DIR/desktop.pid"

    FAIL_COUNT=0
    while true; do
        START_TIME=$(date +%s)

        eval dbus-run-session -- $LAUNCH_CMD || true

        EXIT_TIME=$(date +%s)
        DURATION=$((EXIT_TIME - START_TIME))

        if [ "$DURATION" -lt 3 ]; then
            FAIL_COUNT=$((FAIL_COUNT + 1))
            log_warn "Desktop session exited rapidly ($FAIL_COUNT in a row)"
            # Watchdog auto-fallback to CPU pixman
            if [ "$WLR_RENDERER" = "gles2" ] && [ "$WLR_RENDERER_PREF" != "gles2" ]; then
                log_warn "GLES2 compositor crashed; falling back to CPU pixman renderer"
                export WLR_RENDERER=pixman
            fi
            if [ "$FAIL_COUNT" -gt 5 ]; then
                log_err "Crash loop detected. Cooling down for 5 seconds..."
                sleep 5
                FAIL_COUNT=0
            else
                sleep 1
            fi
        else
            FAIL_COUNT=0
            sleep 0.5
        fi

        log_info "Restarting desktop session..."
    done
}

# ───────────────────────────────────────────────────────────────────
#  Stage 4: Shutdown / Cleanup
# ───────────────────────────────────────────────────────────────────
stage_stop() {
    log_info "Stopping NativOS session and services..."

    # Kill desktop session supervisor
    if [ -f "$RUN_DIR/desktop.pid" ]; then
        PID=$(cat "$RUN_DIR/desktop.pid" 2>/dev/null || true)
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            log_info "Stopping desktop supervisor ($PID)..."
            kill -TERM "$PID" 2>/dev/null || true
        fi
        rm -f "$RUN_DIR/desktop.pid"
    fi

    # Terminate desktop processes for all supported environments
    pkill -x phosh 2>/dev/null || true
    pkill -x phoc 2>/dev/null || true
    pkill -x squeekboard 2>/dev/null || true
    pkill -x plasmashell 2>/dev/null || true
    pkill -x kwin_wayland 2>/dev/null || true
    pkill -x sway 2>/dev/null || true
    pkill -x xfce4-session 2>/dev/null || true
    pkill -x xfwm4 2>/dev/null || true
    pkill -x gnome-shell 2>/dev/null || true
    pkill -x lxqt-session 2>/dev/null || true
    pkill -x mate-session 2>/dev/null || true

    # Terminate daemons
    for s in bridge-client polkitd; do
        if [ -f "$RUN_DIR/$s.pid" ]; then
            PID=$(cat "$RUN_DIR/$s.pid" 2>/dev/null || true)
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                kill -TERM "$PID" 2>/dev/null || true
            fi
            rm -f "$RUN_DIR/$s.pid"
        fi
    done

    pkill -f nativOS-bridge 2>/dev/null || true
    pkill -x sshd 2>/dev/null || true
    pkill -x dbus-daemon 2>/dev/null || true

    # Clean runtime sockets
    rm -rf /tmp/runtime-root/wayland-* /run/dbus/* "$RUN_DIR"/*.pid 2>/dev/null || true

    log_ok "All services stopped"
}

# ───────────────────────────────────────────────────────────────────
#  Status Reporting
# ───────────────────────────────────────────────────────────────────
status() {
    echo "═══════════════════════════════════════════"
    echo "       NativOS Service Status Report       "
    echo "═══════════════════════════════════════════"

    check_proc() {
        NAME="$1"
        PATTERN="$2"
        if pgrep -f "$PATTERN" >/dev/null 2>&1; then
            PID=$(pgrep -f "$PATTERN" | tr '\n' ' ')
            echo "  $NAME: RUNNING (PID: $PID)"
        else
            echo "  $NAME: STOPPED"
        fi
    }

    check_proc "System D-Bus       " "dbus-daemon --system"
    check_proc "Polkit Daemon      " "polkitd"
    check_proc "NativOS Bridge     " "nativOS-bridge"
    check_proc "SSH Server         " "/usr/sbin/sshd"
    check_proc "Phoc Compositor    " "phoc"
    check_proc "Phosh Shell        " "phosh"
    check_proc "Squeekboard (OSK)  " "squeekboard"

    echo ""
    if [ -S /tmp/runtime-root/wayland-0 ]; then
        echo "  Wayland Socket:   READY (/tmp/runtime-root/wayland-0)"
    else
        echo "  Wayland Socket:   NOT FOUND"
    fi

    if [ -S /run/nativOS/bridge.sock ]; then
        echo "  Android Bridge:   CONNECTED (/run/nativOS/bridge.sock)"
    else
        echo "  Android Bridge:   WAITING FOR HOST"
    fi
    echo "═══════════════════════════════════════════"
}

# ───────────────────────────────────────────────────────────────────
#  Entrypoint
# ───────────────────────────────────────────────────────────────────
ACTION="${1:-status}"
shift || true

case "$ACTION" in
    start)
        parse_start_args "$@"
        stage_sysinit
        stage_services
        stage_desktop
        ;;
    stop)
        stage_stop
        ;;
    restart)
        stage_stop
        sleep 1
        parse_start_args "$@"
        stage_sysinit
        stage_services
        stage_desktop
        ;;
    status)
        status
        ;;
    sysinit)
        stage_sysinit
        ;;
    services)
        stage_services
        ;;
    *)
        echo "Usage: $0 {start [OPTIONS]|stop|restart [OPTIONS]|status|sysinit|services}"
        exit 1
        ;;
esac
